# Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://clinically:clinically@localhost:5432/clinically
# true in production (HTTPS), false for local http://localhost
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Used only by pytest. The database is created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://clinically:clinically@localhost:5432/clinically_test
