# Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://clinically:clinically@localhost:5432/clinically
# true in production (HTTPS), false for local http://localhost
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# The website's address; live updates only accept connections from it.
FRONTEND_ORIGIN=http://localhost:3000
# Folder holding uploaded prescriptions and reports.
RECORDS_DIR=storage/records
# Folder holding doctor photos.
MEDIA_DIR=storage/media

# Messages to patients (e.g. "OPD has started"). "log" writes them to the server log; a real
# SMS/WhatsApp provider is added in app/messaging.py.
NOTIFY_CHANNEL=log

# Online token-amount payments. "fake" needs no keys (dev/tests only); use "razorpay" in production.
PAYMENT_GATEWAY=fake
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Used only by pytest. The database is created automatically if missing.
TEST_DATABASE_URL=postgresql+psycopg://clinically:clinically@localhost:5432/clinically_test
